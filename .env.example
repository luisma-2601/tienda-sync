# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# URL pública de la tienda (para vistas previas al compartir el link)
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# Fichas de producto con IA (Panel > Productos > "Completar fichas con IA"). Solo se usan en el servidor.
# Proveedor: "gemini" (por defecto, tiene capa gratuita) o "anthropic".
TIENDA_IA_PROVEEDOR=gemini
# Clave de Google AI Studio (https://aistudio.google.com/apikey). Se envía en un header, nunca en la URL.
GEMINI_API_KEY=
# Modelo de Gemini. Si Google lo retira o cambia la capa gratuita, cambia aquí el nombre.
# Si Google responde 404, el modelo no está disponible para tu clave: los 2.5 solo siguen para cuentas que ya los usaban.
# Opciones vigentes con capa gratuita: gemini-3.8-flash (por defecto), gemini-3.5-flash-lite (más barato).
TIENDA_MODELO_GEMINI=gemini-3.8-flash
# Pausa entre producto y producto en el lote, en milisegundos. La capa gratuita limita las peticiones
# por minuto: 13000 (≈4-5 por minuto) evita el error de cuota. Bájala si tu plan lo permite.
TIENDA_IA_PAUSA_MS=13000
# Solo si TIENDA_IA_PROVEEDOR=anthropic: clave y modelo (opcional) de Anthropic.
# ANTHROPIC_API_KEY=
# TIENDA_MODELO_IA=claude-haiku-5-5

# Lote de fichas con IA en segundo plano (ver supabase/FICHAS_IA.md). Solo en el servidor: nunca con NEXT_PUBLIC_.
# Supabase: Project Settings > API Keys > service_role. Salta RLS: solo la usa /api/fichas-ia.
SUPABASE_SERVICE_ROLE_KEY=
# El mismo valor del secreto cron_secret del Vault (el de la tasa automática). pg_cron lo envía en x-cron-secret.
CRON_SECRET=
